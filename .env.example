# 复制本文件为 .env，填入你的 5 个 MiniMax 账号 key。
# 只填了几个也没关系——config.ts 会自动跳过空值，用几个就并行几个。

MINIMAX_KEY_1=sk-cp-xxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_KEY_2=sk-cp-xxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_KEY_3=sk-cp-xxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_KEY_4=sk-cp-xxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_KEY_5=sk-cp-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖默认端点/模型（默认 https://api.minimaxi.com/anthropic 和 MiniMax-M2）。
# 比如想换 M3：把下行注释解开并改成 MiniMax-M3。
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
# MINIMAX_MODEL=MiniMax-M3

# 密钥轮换兜底：on = 一个 key 的 token 耗尽后，自动换下一个 key 继续执行，
                直到所有 key 都耗尽才优雅停机；
                off = 维持旧行为（默认第一个 key 用完就停）。
# KEY_FALLBACK=on

# 每个 key 的 token 预算（达到即视为该 key 耗尽）。默认 1_000_000。
# PER_KEY_TOKEN_BUDGET=1000000
