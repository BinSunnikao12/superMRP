# APS MRP 服务环境变量样例
# 复制为 .env 即可生效；docker-compose 默认会读 .env

# ====== 数据源（推荐 api）======
# api    → 走 CE 低代码平台 ApiEngine（生产推荐，不直连 Oracle）
# direct → 直连 Oracle（仅内部调试，需保证能访问 192.168.0.199:1521）
MRP_ORACLE_SOURCE=api

# ====== MOCK 模式（本地开发用）======
# true  → 走本地 fixtures（src/data/mock/fixtures/），完全不用连 Oracle/CE
#         适合没有 VPN 也能跑
MOCK_MODE=true
MOCK_STRICT=false

# ====== 乐歌低代码平台 API（MRP_ORACLE_SOURCE=api 时必填）======
LOWCODE_API_BASE_URL=http://lowcode.loctek.local:8089
# 首次运行会自动用账号密码登录；登录后 token 存 .lowcode-token
LOWCODE_USER=admin
LOWCODE_PASSWORD=your_password_here

# ====== MySQL 容器（compose 网络内用服务名 mrp-mysql）======
MRP_MYSQL_HOST=mrp-mysql
MRP_MYSQL_PORT=3306
MRP_MYSQL_USER=root
MRP_MYSQL_PASSWORD=loctek@2023
MRP_MYSQL_DATABASE=mrp

# ====== 低代码平台 MES（沿用旧地址）======
MRP_MES_HOST=10.19.204.8
MRP_MES_USER=lowcode
MRP_MES_PASSWORD=6V_YBn*q
MRP_MES_DATABASE=lowcode

# ====== Oracle ERP（仅 MRP_ORACLE_SOURCE=direct 时用）======
MRP_ORACLE_USER=erp_reader
MRP_ORACLE_PASSWORD=erp#query
MRP_ORACLE_CONNECT_STRING=192.168.0.199:1521/topprd
MRP_ORACLE_SCHEMA=

# 五个基地，逗号分隔
MRP_SITES=LG,YN,QU,GX,FN

# ====== 缓存（LRU + TTL，秒）======
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=64

# ====== 性能参数 ======
BOM_MAX_DEPTH=200
DB_POOL_SIZE=10
API_MAX_PAGE_SIZE=5000

# ====== HTTP 下载服务 ======
APS_HTTP_PORT=8080
